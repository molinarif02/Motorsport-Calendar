# Copy to .env (same folder as docker-compose.yml). Both values are optional.

# YouTube Data API v3 key: exact live-video links instead of channel pages (docs/streaming.md)
YOUTUBE_API_KEY=

# Cloudflare Tunnel token, used with: docker compose --profile tunnel up -d (docs/deployment.md)
TUNNEL_TOKEN=

# Folder with your own config.yaml + manual.yaml (git ignores config.local/, so
# `git pull` never touches it). Default: ./config, the shipped example.
# CONFIG_DIR=./config.local
